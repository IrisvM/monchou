{
  "name": "monchou",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "dev/apply-git-hooks",
    "dev": "bun scripts/build-index.ts && next dev",
    "build": "bun scripts/build-index.ts && next build",
    "start": "next start",
    "lint": "eslint && prettier . -c",
    "fix": "eslint --fix && prettier . -w"
