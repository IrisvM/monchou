  "lint-staged": {
    "*.{js,tsx,ts}": [
      "eslint --fix",
      "prettier -w ."
    ],
    "*.{json,md}": [
      "prettier -w ."
    ]
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "html-react-parser": "^6.1.7",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "postcss-import": "^17.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "resolutions": {
    "@typescript-eslint/eslint-plugin": "8.15.0",
    "@typescript-eslint/parser": "8.15.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  }
